// Orange 的 GKD 个人订阅
// 托管: https://1996818.xyz/testFile/gkd/gkd.json5 (testFile 仓库 GitHub Pages, push 即生效)
// 导入: 手机 GKD → 订阅 → 添加订阅,粘贴上面 URL;或电脑执行 docs 里的 adb 深链命令
// 维护指南见同目录 README.md。改完规则记得 version += 1,GKD 才会提示更新
// 2026-10-28 v2: 全量盘点 94 个应用后人工补充 9 个缺口应用; 每日 9 点由 NEC8 定时任务自动检查补充(cron/)
{
  id: 20261028,
  name: 'Orange个人订阅',
  version: 2,
  author: 'notEatOranges',
  categories: [
    { key: 0, name: '开屏广告' },
    { key: 1, name: '弹窗广告' },
    { key: 2, name: '功能类' },
  ],
  globalGroups: [
    {
      key: 10,
      name: '开屏广告-全局兜底',
      desc: '官方订阅没覆盖到的应用也能自动点「跳过」。已排除银行/政务/支付/认证类应用。默认关闭,想开到 GKD 订阅页手动打开',
      enable: false,
      matchAnyApp: true,
      excludeMatchedAppIds: [
        // 银行/支付/认证类,误点风险高,一律排除
        'com.bankcomm.Bankcomm',
        'com.chinamworld.bocmbci',
        'com.chinamworld.main',
        'com.cmbchina.ccd.pluto.cmbActivity',
        'com.unionpay',
        'com.eg.android.AlipayGphone',
        'com.hicorenational.antifraud',
        'cn.cyberIdentity.certification',
        'com.google.android.apps.authenticator2',
        'io.enpass.app',
        'com.hihonor.wallet',
        // 政务/民生类
        'com.cn.gov.tax.its',
        'com.MobileTicket',
        'com.sgcc.wsgw.cn',
        'com.tmri.app.main',
        'com.sinovatech.unicom.ui',
        'com.greenpoint.android.mc10086.activity',
      ],
      rules: [
        {
          matches: '[text*="跳过"][text.length<=4][visibleToUser=true]',
          action: 'click',
          quickFind: true,
          actionMaximum: 1,
          resetMatch: 'app',
        },
        {
          anyMatches: [
            '[vid*="skip"][visibleToUser=true]',
            '[id*="skip"][id.length<25][visibleToUser=true]',
          ],
          action: 'click',
          quickFind: true,
          actionMaximum: 1,
          resetMatch: 'app',
        },
      ],
    },
  ],
