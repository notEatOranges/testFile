        'com.tmri.app.main',
        'com.sinovatech.unicom.ui',
        'com.greenpoint.android.mc10086.activity',
      ],
      rules: [
        {
          matches: '[text*="跳过"][text.length<=4][visibleToUser=true]',
          action: 'click',
          quickFind: true,
          actionMaximum: 1,
          resetMatch: 'app',
        },
        {
